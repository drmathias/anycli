{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src/AnyCli/bin/Release/net11.0",
          "files": [
            "AnyCli.dll"
          ]
        },
        {
          "src": "../src/AnyCli.SpectreConsole/bin/Release/net11.0",
          "files": [
            "AnyCli.SpectreConsole.dll"
          ]
        }
      ],
      "dest": "api",
      "memberLayout": "samePage",
      "namespaceLayout": "nested"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.md",
          "**/*.yml"
        ],
        "exclude": [
          "_site/**",
          "node_modules/**",
          "obj/**"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default",
      "modern",
      "template"
    ],
    "globalMetadata": {
      "_appName": "anycli",
      "_appTitle": "AnyCli Documentation",
      "_appLogoPath": "branding/anycli-logo.svg",
      "_appFaviconPath": "branding/favicon.ico",
      "_appFooter": "Licensed under the MIT license | Docs Built with <a href=\"https://dotnet.github.io/docfx/docs/basic-concepts.html\">docfx</a>",
      "_enableSearch": true,
      "_disableToc": false,
      "_disableAffix": false,
      "_disableBreadcrumb": true,
      "_disableNextArticle": true,
      "_gitContribute": {
        "repo": "https://github.com/drmathias/anycli",
        "branch": "main"
      },
      "_lang": "en"
    },
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "../branding",
        "dest": "branding",
        "files": [
          "**"
        ]
      }
    ]
  }
}
