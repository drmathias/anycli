<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>AnyCli</PackageId>
    <Title>AnyCli</Title>
    <Description>A source-generated, AOT-friendly command-line framework for .NET</Description>
    <PackageTags>cli;command-line;parser;source-generator;aot;roslyn;dependency-injection</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);PackAnyCliGenerator</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AnyCli.Generators\AnyCli.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
  </ItemGroup>

  <Target Name="PackAnyCliGenerator">
    <MSBuild Projects="..\AnyCli.Generators\AnyCli.Generators.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework;TargetFrameworks">
      <Output TaskParameter="TargetOutputs" ItemName="AnyCliGeneratorOutput" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(AnyCliGeneratorOutput)">
        <PackagePath>analyzers/dotnet/cs</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
